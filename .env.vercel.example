# Paste these into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Framework Preset must be "Services".

APP_ENV=production
APP_NAME=Quantify
PUBLIC_ACCESS=true
APP_ACCESS_TOKEN=

ENABLE_DOCS=false
ALLOW_RUNTIME_LLM_CONFIG=false
RATE_LIMIT_PER_MINUTE=90
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=*

# Free mode: builtin parser, no OpenAI key required
FORCE_BUILTIN_PARSER=true
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Leave unset on Vercel — the API writes SQLite + uploads under /tmp
# DATABASE_URL=
# DATA_DIR=
# UPLOAD_DIR=
