# Vercel Services container for the Quantify FastAPI API.
# Listens on $PORT (default 80). Writable state goes to /tmp.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    APP_ENV=production \
    FORCE_BUILTIN_PARSER=true \
    CORS_ORIGINS=* \
    DATA_DIR=/app/data \
    UPLOAD_DIR=/tmp/quantify/uploads \
    DATABASE_URL=sqlite:////tmp/quantify/backtests.db

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir "uvicorn[standard]==0.34.0"

COPY app /app/app
COPY data /app/data
COPY pyproject.toml /app/pyproject.toml

RUN mkdir -p /tmp/quantify/uploads /tmp/quantify \
    && useradd --system --uid 10001 --create-home app \
    && chown -R app:app /app /tmp/quantify

USER app

EXPOSE 80

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80} --proxy-headers --forwarded-allow-ips '*'"]
