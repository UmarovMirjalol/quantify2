# Local development — copy to .env
APP_ENV=development
APP_NAME=Quantify
APP_PORT=8080

# Leave empty locally (no access gate). Set in production.
APP_ACCESS_TOKEN=

ENABLE_DOCS=true
ALLOW_RUNTIME_LLM_CONFIG=true
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=25

CORS_ORIGINS=http://localhost:43127,http://127.0.0.1:43127,http://localhost:3000,http://127.0.0.1:3000,http://localhost:18080,http://127.0.0.1:18080,http://localhost:4173,http://127.0.0.1:4173

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
FORCE_BUILTIN_PARSER=false

DATABASE_URL=sqlite:///./backtests.db
DATA_DIR=./data
UPLOAD_DIR=./uploads
