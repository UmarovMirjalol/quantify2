# Production environment — deploy.sh uses .env.production by default:
#   cp .env.production.example .env.production
#   ./deploy/scripts/deploy.sh   # auto-fills APP_ACCESS_TOKEN if empty

APP_PORT=80
IMAGE_TAG=latest
APP_NAME=Quantify
COMPOSE_PROJECT_NAME=quantify

# Public free launch for end users:
#   PUBLIC_ACCESS=true  → no login gate, anyone can test
#   PUBLIC_ACCESS=false → deploy.sh generates APP_ACCESS_TOKEN if empty
PUBLIC_ACCESS=true
APP_ACCESS_TOKEN=

# Security / ops
ENABLE_DOCS=false
ALLOW_RUNTIME_LLM_CONFIG=false
RATE_LIMIT_PER_MINUTE=90
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=*

# Free mode: leave LLM_API_KEY empty and FORCE_BUILTIN_PARSER=true
# so users never need (or pay for) an OpenAI key.
# Optional paid NLP: set LLM_API_KEY from https://platform.openai.com/api-keys
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
FORCE_BUILTIN_PARSER=true

DATABASE_URL=sqlite:////data/backtests.db

# HTTPS overlay (docker-compose.https.yml)
# DOMAIN=app.example.com
# EMAIL=ops@example.com
