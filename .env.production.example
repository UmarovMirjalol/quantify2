# Production environment template — copy to .env before deploy
#   cp .env.production.example .env

# Public HTTP port on the host (edge nginx)
APP_PORT=80

# Image tag for built services
IMAGE_TAG=latest

# Optional LLM (leave empty to use built-in parser)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
FORCE_BUILTIN_PARSER=false

# Comma-separated origins, or * for same-origin / open API
CORS_ORIGINS=*

# Upload limit
MAX_UPLOAD_SIZE_MB=25

# SQLite path is managed inside the container volume
DATABASE_URL=sqlite:////data/backtests.db
