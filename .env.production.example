# Production environment — copy to .env before deploy:
#   cp .env.production.example .env
#   ./deploy/scripts/deploy.sh   # auto-fills APP_ACCESS_TOKEN if empty

APP_PORT=80
IMAGE_TAG=latest
APP_NAME=Quantify

# REQUIRED for user access (deploy.sh generates one if empty)
APP_ACCESS_TOKEN=

# Security / ops
ENABLE_DOCS=false
ALLOW_RUNTIME_LLM_CONFIG=false
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=*

# LLM (optional — built-in parser works without a key)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
FORCE_BUILTIN_PARSER=false

DATABASE_URL=sqlite:////data/backtests.db

# HTTPS overlay (docker-compose.https.yml)
# DOMAIN=app.example.com
# EMAIL=ops@example.com
