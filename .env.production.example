# Production environment — deploy.sh uses .env.production by default:
#   cp .env.production.example .env.production
#   ./deploy/scripts/deploy.sh   # auto-fills APP_ACCESS_TOKEN if empty

APP_PORT=80
IMAGE_TAG=latest
APP_NAME=Quantify
COMPOSE_PROJECT_NAME=quantify

# REQUIRED for the first-visit Access Gate (deploy.sh generates one if empty).
# This is NOT an OpenAI key — it is your shared app password.
APP_ACCESS_TOKEN=

# Security / ops
ENABLE_DOCS=false
ALLOW_RUNTIME_LLM_CONFIG=false
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=*

# Optional LLM (built-in parser works with this empty).
# Get a key at: https://platform.openai.com/api-keys
# Or any OpenAI-compatible provider — set LLM_BASE_URL accordingly.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
FORCE_BUILTIN_PARSER=false

DATABASE_URL=sqlite:////data/backtests.db

# HTTPS overlay (docker-compose.https.yml)
# DOMAIN=app.example.com
# EMAIL=ops@example.com
